{
  "_comment": "Safe local defaults only. Put real Discord client secret and service tokens in .NET User Secrets or appsettings.Development.local.json (gitignored).",
  "ConnectionStrings": {
    "ActivitiesDatabase": "Host=localhost;Port=5432;Database=discordbot_activities;Username=postgres;Password=postgres"
  },
  "Discord": {
    "ClientId": "YOUR_DISCORD_CLIENT_ID",
    "ClientSecret": "YOUR_DISCORD_CLIENT_SECRET",
    "RedirectUri": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "DiscordBot.Activities",
    "Audience": "DiscordBot.Activity",
    "SigningKey": "local-development-activities-jwt-signing-key-change-me",
    "AccessTokenMinutes": 30
  },
  "PlatformApi": {
    "BaseUrl": "https://localhost:5001",
    "ServiceToken": "local-development-activities-service-token-change-me"
  },
  "ActivitiesAuth": {
    "AllowMissingActivityInstanceInDevelopment": false
  },
  "LocalBrowserMode": {
    "Enabled": true,
    "GuildDiscordId": "1521518056852029440",
    "ChannelDiscordId": "1523998706331029574",
    "ActivityInstanceId": "local-browser-activity",
    "Profiles": [
      {
        "Name": "PlayerA",
        "DiscordUserId": "900000000000000001",
        "Username": "لاعب A"
      },
      {
        "Name": "PlayerB",
        "DiscordUserId": "900000000000000002",
        "Username": "لاعب B"
      }
    ]
  },
  "Roulette": {
    "WaitingRoomExpirationMinutes": 60,
    "InProgressAbandonmentMinutes": 180,
    "ResumeWindowMinutes": 720,
    "JoinIntentExpirationMinutes": 5,
    "CleanupIntervalSeconds": 60
  },
  "ActivitiesDiagnostics": {
    "ServiceToken": "local-development-activities-diagnostics-token-change-me"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "DiscordBot": "Debug"
    }
  },
  "AllowedHosts": "*"
}
