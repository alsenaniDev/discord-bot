{
  "_comment": "Safe local defaults only. Put real Discord secrets/tokens in .NET User Secrets or appsettings.Development.local.json (gitignored).",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=discordbot_platform;Username=postgres;Password=postgres"
  },
  "Discord": {
    "ClientId": "YOUR_DISCORD_CLIENT_ID",
    "ClientSecret": "YOUR_DISCORD_CLIENT_SECRET",
    "BotToken": "YOUR_DISCORD_BOT_TOKEN",
    "RedirectUri": "https://localhost:5001/api/auth/discord/callback",
    "DashboardUrl": "http://localhost:4200",
    "ActivityUrl": "http://localhost:5173",
    "AllowVercelOrigins": false
  },
  "Bot": {
    "ApiKey": "local-development-bot-api-key-change-me"
  },
  "ActivitiesIntegration": {
    "ServiceToken": "local-development-activities-service-token-change-me"
  },
  "Jwt": {
    "Secret": "local-development-jwt-signing-key-change-me-123456789",
    "Issuer": "DiscordBot",
    "Audience": "DiscordBot.Dashboard",
    "ExpiresMinutes": 60
  },
  "Admin": {
    "DiscordUserId": "YOUR_DISCORD_USER_ID"
  },
  "Seed": {
    "Enabled": false,
    "OwnerDiscordUserId": "",
    "DiscordGuildId": "123456789012345678",
    "GuildName": "My Test Server"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "DiscordBot": "Debug"
    }
  },
  "AllowedHosts": "*"
}
