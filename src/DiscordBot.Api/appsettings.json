{
  "_comment": "Safe defaults only. Copy appsettings.example.json or appsettings.Development.example.json to appsettings.Development.local.json for local secrets.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=discordbot;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Discord": {
    "ClientId": "YOUR_DISCORD_CLIENT_ID",
    "ClientSecret": "YOUR_DISCORD_CLIENT_SECRET",
    "BotToken": "YOUR_DISCORD_BOT_TOKEN",
    "RedirectUri": "https://api.your-domain.com/api/auth/discord/callback",
    "DashboardUrl": "https://dashboard.your-domain.com",
    "ActivityUrl": "https://YOUR_DISCORD_CLIENT_ID.discordsays.com"
  },
  "Bot": {
    "ApiKey": "CHANGE_ME_STRONG_BOT_API_KEY"
  },
  "ActivitiesIntegration": {
    "ServiceToken": "CHANGE_ME_STRONG_ACTIVITIES_SERVICE_TOKEN"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_AT_LEAST_32_CHARACTER_SECRET",
    "Issuer": "DiscordBot",
    "Audience": "DiscordBot.Dashboard",
    "ExpiresMinutes": 60
  },
  "Admin": {
    "DiscordUserId": "YOUR_DISCORD_USER_ID"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DiscordBot": "Information"
    }
  },
  "AllowedHosts": "*"
}
