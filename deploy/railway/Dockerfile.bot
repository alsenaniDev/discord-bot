# Discord Bot Platform — Bot worker (Railway)
# Build context: repository root
# Railway: disable public networking on this service (worker only)

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY DiscordBot.sln .
COPY src/DiscordBot.Domain/DiscordBot.Domain.csproj src/DiscordBot.Domain/
COPY src/DiscordBot.Bot/DiscordBot.Bot.csproj src/DiscordBot.Bot/

RUN dotnet restore src/DiscordBot.Bot/DiscordBot.Bot.csproj
COPY src/ src/
RUN dotnet publish src/DiscordBot.Bot/DiscordBot.Bot.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_EnableDiagnostics=0

COPY --from=build /app/publish .

USER app
ENTRYPOINT ["dotnet", "DiscordBot.Bot.dll"]
