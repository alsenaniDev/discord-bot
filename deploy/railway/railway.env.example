# Railway environment variables (reference only — do not put real secrets here)
#
# Copy variable names into Railway → Service → Variables.
# Use Railway "Reference" syntax to link Postgres to the API service.
#
# API service variables:
# ----------------------
# ASPNETCORE_ENVIRONMENT=Production
#
# ConnectionStrings__DefaultConnection=Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};Database=${{Postgres.PGDATABASE}};Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}};SSL Mode=Require;Trust Server Certificate=true
#
# Discord__ClientId=YOUR_DISCORD_CLIENT_ID
# Discord__ClientSecret=YOUR_DISCORD_CLIENT_SECRET
# Discord__BotToken=YOUR_DISCORD_BOT_TOKEN
# Discord__RedirectUri=https://YOUR_API_DOMAIN/api/auth/discord/callback
# Discord__DashboardUrl=https://YOUR_DASHBOARD_DOMAIN
# Discord__ActivityUrl=https://YOUR_DISCORD_CLIENT_ID.discordsays.com
# Discord__AllowVercelOrigins=true
#
# Bot__ApiKey=CHANGE_ME_STRONG_BOT_API_KEY
#
# Jwt__Secret=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Jwt__Issuer=DiscordBot
# Jwt__Audience=DiscordBot.Dashboard
#
# Admin__DiscordUserId=YOUR_DISCORD_USER_ID
#
# Bot worker service variables:
# -----------------------------
# ASPNETCORE_ENVIRONMENT=Production
#
# Discord__Token=YOUR_DISCORD_BOT_TOKEN
# Api__BaseUrl=https://YOUR_API_DOMAIN
# Api__ApiKey=CHANGE_ME_STRONG_BOT_API_KEY
# Platform__DashboardUrl=https://YOUR_DASHBOARD_DOMAIN
# Lavalink__Host=lavalink.railway.internal
# Lavalink__Port=2333
# Lavalink__Password=${{lavalink.LAVALINK_SERVER_PASSWORD}}
# Lavalink__Secure=false
# Lavalink__SearchPrefix=ytsearch
# Lavalink__IdleTimeoutSeconds=60
#
# Lavalink private service variables:
# -----------------------------------
# LAVALINK_SERVER_PASSWORD=GENERATE_A_STRONG_RANDOM_SECRET
# SERVER_PORT=2333
# _JAVA_OPTIONS=-Xms256M -Xmx512M
#
# Keep Railway Public Networking and TCP Proxy disabled for Lavalink.
#
# Dashboard (Railway Docker build arg):
# -------------------------------------
# API_URL=https://YOUR_API_DOMAIN
#
# Dashboard (Vercel environment variable — set before build):
# -----------------------------------------------------------
# Current deployment reads the API URL from src/environments/environment.production.ts.
# Confirm it is the Railway API HTTPS URL before every Vercel production build.
#
# Activity frontend build variables:
# ----------------------------------
# VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
# VITE_API_BASE_URL=
# Leave VITE_API_BASE_URL empty when /api is configured through Discord Activity URL Mappings.
