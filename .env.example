# =============================================================================
# Discord Bot Platform — environment variable reference
# =============================================================================
# .NET maps double-underscore env vars to nested JSON config automatically.
#
# Local dev (recommended):
#   cp src/DiscordBot.Api/appsettings.Development.example.json \
#      src/DiscordBot.Api/appsettings.Development.local.json
#   cp src/DiscordBot.Bot/appsettings.Development.example.json \
#      src/DiscordBot.Bot/appsettings.Development.local.json
#
# Production / Docker / hosting:
#   Set these env vars on the API, Bot, and PostgreSQL services.
#   Do NOT commit a real .env file — copy this to .env locally only.
# =============================================================================

# --- PostgreSQL (API) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=discordbot;Username=postgres;Password=postgres

# --- Discord OAuth (API) ---
Discord__ClientId=YOUR_DISCORD_CLIENT_ID
Discord__ClientSecret=YOUR_DISCORD_CLIENT_SECRET
Discord__BotToken=YOUR_DISCORD_BOT_TOKEN
Discord__RedirectUri=http://localhost:5217/api/auth/discord/callback
Discord__DashboardUrl=http://localhost:4200

# --- Bot ↔ API shared secret (must match on both services) ---
Bot__ApiKey=CHANGE_ME_STRONG_BOT_API_KEY

# --- JWT (API — minimum 32 characters) ---
Jwt__Secret=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=DiscordBot
Jwt__Audience=DiscordBot.Dashboard
Jwt__ExpiresMinutes=60

# --- Platform admin (API — your Discord user ID) ---
Admin__DiscordUserId=YOUR_DISCORD_USER_ID

# --- Bot worker ---
Discord__Token=YOUR_DISCORD_BOT_TOKEN
Api__BaseUrl=http://localhost:5217
Api__ApiKey=CHANGE_ME_STRONG_BOT_API_KEY
Platform__DashboardUrl=http://localhost:4200

# --- Angular dashboard (set before `npm run build`) ---
# Edit dashboard/DiscordBot.Dashboard/src/environments/environment.ts
#   apiUrl: 'https://api.your-domain.com'

# =============================================================================
# Production example (HTTPS)
# =============================================================================
# Discord__RedirectUri=https://api.your-domain.com/api/auth/discord/callback
# Discord__DashboardUrl=https://dashboard.your-domain.com
# Api__BaseUrl=https://api.your-domain.com
# Platform__DashboardUrl=https://dashboard.your-domain.com
