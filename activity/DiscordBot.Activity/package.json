{
  "name": "discordbot-activity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-production-env.mjs && tsc -b && vite build && node scripts/sanitize-production-bundle.mjs && node scripts/assert-production-bundle.mjs",
    "assert:bundle": "node scripts/assert-production-bundle.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@microsoft/signalr": "^8.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
